# ============================================================ TimeLog configuration
# Copy to .env and adapt. Never commit .env.

# --- General
APP_NAME=Timelog
# FQDN in the TLS certificate
SERVER_NAME=timelog.corp.example.lu
# used in notification e-mails
APP_BASE_URL=https://timelog.corp.example.lu
# signs session cookies
SECRET_KEY=change-me-run-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me
CURRENCY=EUR
# seconds (8h)
SESSION_MAX_AGE=28800
# overtime night window
NIGHT_START=22:00
NIGHT_END=06:00
# overtime granularity in minutes (also the minimum duration of an entry)
OVERTIME_STEP_MINUTES=15
# how many months back employees may still log overtime
OVERTIME_LOOKBACK_MONTHS=12
# Finance cut-off: approvals up to this day of month M+1 are paid with month M; later ones are paid the following month.
# Can be changed in Admin > Settings (the stored value wins over this one).
PAYROLL_CUTOFF_DAY=5
# first day of the on-call rotation week (mon..sun); default rotation Friday -> Thursday
ONCALL_WEEK_START=fri
# login throttle is per worker
WEB_WORKERS=1
# app port is only reachable from the proxy
FORWARDED_ALLOW_IPS=*
HTTP_PORT=80
HTTPS_PORT=443
# only when HTTPS_PORT is not 443: the HTTP->HTTPS redirect must include it, e.g. :8443
HTTPS_PORT_SUFFIX=

# --- Build (air-gapped: point to an internal PyPI mirror)
# PIP_INDEX_URL=https://nexus.corp.example.lu/repository/pypi/simple
# PIP_TRUSTED_HOST=nexus.corp.example.lu

# --- Local accounts (bootstrap / debugging)
LOCAL_LOGIN_ENABLED=true
# true in production: only local break-glass admin
LOCAL_LOGIN_ADMIN_ONLY=false
# created at startup if no admin exists
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-please

# --- LDAP / Active Directory
LDAP_ENABLED=false
LDAP_URL=ldaps://dc01.corp.example.lu:636
# true with ldap://...:389
LDAP_START_TLS=false
# Microsoft PKI root + issuing CA (PEM)
LDAP_CA_CERT_FILE=/certs/ldap-ca.pem
LDAP_VERIFY_CERT=true
LDAP_BIND_DN=CN=svc-timelog,OU=Service Accounts,DC=corp,DC=example,DC=lu
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=OU=Users,DC=corp,DC=example,DC=lu
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={username}))
LDAP_ATTR_USERNAME=sAMAccountName
LDAP_ATTR_FIRST_NAME=givenName
LDAP_ATTR_LAST_NAME=sn
LDAP_ATTR_DISPLAY_NAME=displayName
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_EMPLOYEE_ID=employeeID
LDAP_ATTR_TEAM=department
LDAP_ATTR_MANAGER=manager
# Group DNs (nested membership resolved by AD). Empty = flag managed manually in the admin UI.
LDAP_GROUP_REQUIRED=CN=APP-TimeLog-Users,OU=Groups,DC=corp,DC=example,DC=lu
LDAP_GROUP_ADMIN=CN=APP-TimeLog-Admins,OU=Groups,DC=corp,DC=example,DC=lu
LDAP_GROUP_EXPERT=CN=APP-TimeLog-Experts,OU=Groups,DC=corp,DC=example,DC=lu
LDAP_GROUP_PROCUREMENT=CN=APP-TimeLog-Procurement,OU=Groups,DC=corp,DC=example,DC=lu
LDAP_TIMEOUT=10

# --- Backups (Admin > Backup: schedule, download, restore). Files go to the 'backups' volume (/backups).
# Backups are encrypted with this passphrase; empty = derived from SECRET_KEY. Keep it safe: without it a backup
# cannot be read. Changing it later makes older backups need their original passphrase to be restored/uploaded.
BACKUP_PASSPHRASE=
# Run the scheduler thread (the schedule itself is set in the admin interface).
BACKUP_SCHEDULER=true

# --- E-mail notifications (optional; disabled when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=timelog@corp.example.lu
